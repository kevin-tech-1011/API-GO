{
    "name": "resume_ai",
    "version": "1.0.0",
    "scripts": {
        "dev": "node ./node_modules/cross-env/dist/bin/cross-env.js NODE_ENV=development node ./node_modules/nodemon/bin/nodemon.js --watch \"./backend\" --ext \"ts,json\" --exec \"node ./node_modules/tsx/dist/cli.mjs ./backend/index.ts\"",
        "build:backend": "node ./node_modules/typescript/bin/tsc -b ./backend",
        "build:frontend": "cd frontend && node ../node_modules/typescript/bin/tsc -b && node ../node_modules/vite/bin/vite.js build",
        "build": "npm run build:frontend && npm run build:backend",
        "start": "node ./node_modules/cross-env/dist/bin/cross-env.js NODE_ENV=production node ./backend/dist/index.js",
        "lint": "node ./node_modules/eslint/bin/eslint.js .",
        "prepare": "node ./node_modules/husky/bin.js",
        "postinstall": "node ./node_modules/ts-node/dist/bin.js ./backend/scripts/seed-super-admin.ts"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "author": "",
    "license": "ISC",
    "description": "",
